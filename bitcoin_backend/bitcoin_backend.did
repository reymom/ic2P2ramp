type BitcoinError = variant {
  ParseAmountError : text;
  InvalidRunestone : text;
  InvalidInput : text;
  ParsingError : text;
  UnsupportedAddressType : text;
  CryptoError : text;
  InsufficientBalance : InsufficientBalanceError;
  InvalidRuneID : text;
  VaultError : VaultError;
  TaprootError : text;
  CallRejectionError : record { RejectionCode; text };
  InternalError : text;
  TaprootNotFinalizable;
  UnsupportedRune : text;
  UnsupportedTransaction;
};
type Etching = record {
  height : opt record { nat64; nat64 };
  metadata : RuneMetadata;
  offset : opt record { nat64; nat64 };
  spacers : opt nat32;
  amount : opt nat;
};
type GetBlockHeadersResponse = record {
  tip_height : nat32;
  block_headers : vec blob;
};
type Inscription = record {
  content : text;
  metadata : opt text;
  content_type : text;
};
type InsufficientBalanceError = record {
  fee : nat64;
  current_balance : nat64;
  transfer_amount : nat64;
};
type Network = variant { mainnet; regtest; testnet };
type OutPoint = record { txid : blob; vout : nat32 };
type RejectionCode = variant {
  NoError;
  CanisterError;
  SysTransient;
  DestinationInvalid;
  Unknown;
  SysFatal;
  CanisterReject;
};
type Result = variant { Ok; Err : BitcoinError };
type Result_1 = variant { Ok : nat64; Err : BitcoinError };
type Result_2 = variant { Ok : GetBlockHeadersResponse; Err : BitcoinError };
type Result_3 = variant { Ok : VaultEntry; Err : BitcoinError };
type Result_4 = variant { Ok : text; Err : BitcoinError };
type Result_5 = variant { Ok : vec RuneMetadata; Err : BitcoinError };
type Result_6 = variant {
  Ok : record { RuneMetadata; text };
  Err : BitcoinError;
};
type Result_7 = variant {
  Ok : record { vec Utxo; vec record { Utxo; RuneUTXOEntry } };
  Err : BitcoinError;
};
type RuneMetadata = record {
  id : text;
  cap : nat;
  premine : nat;
  name : text;
  divisibility : nat8;
  symbol : text;
};
type RuneUTXOEntry = record {
  script_pubkey : text;
  txid : text;
  vout : nat32;
  rune_amount : nat64;
};
type TransactionType = variant {
  RuneEtching : Etching;
  OrdinalInscription : Inscription;
  RuneTransfer : text;
  LegacyBitcoin;
  OrdinalTransfer;
  TaprootBitcoin;
};
type Utxo = record { height : nat32; value : nat64; outpoint : OutPoint };
type VaultEntry = record {
  bitcoin_balance : nat64;
  runes : vec record { text; nat64 };
};
type VaultError = variant {
  InsufficientBalance;
  InsufficientLockedBalance;
  AddressVaultNotFound;
};
service : (Network) -> {
  cancel_deposit : (text, nat64, opt text, vec RuneUTXOEntry) -> (Result);
  complete_order : (text, nat64, opt text, vec RuneUTXOEntry) -> (Result);
  deposit_to_address_vault : (text, nat64, opt text, vec RuneUTXOEntry) -> (
      Result,
    );
  estimate_bitcoin_transaction_fee : () -> (Result_1);
  get_btc_balance : (text) -> (Result_1);
  get_btc_block_headers : () -> (Result_2);
  get_canister_rune_amount : (text) -> (Result_1) query;
  get_offramper_deposits : (text) -> (Result_3) query;
  get_onramper_deposits : (text) -> (Result_3) query;
  get_p2pkh_address : () -> (Result_4);
  get_p2tr_raw_key_spend_address : () -> (Result_4);
  get_p2tr_script_spend_address : (TransactionType) -> (Result_4);
  get_registered_runes : () -> (Result_5) query;
  get_rune_utxos : (text) -> (vec RuneUTXOEntry) query;
  get_serialized_rune_metadata : (text) -> (Result_6) query;
  get_utxos : (text, TransactionType) -> (Result_7);
  inscribe_ordinals_inscription : (text, text, opt text, text, nat64) -> (
      Result_4,
    );
  lock_funds : (text, text, nat64, opt text) -> (Result);
  register_runes : (vec RuneMetadata) -> (Result);
  transfer : (text, nat64, TransactionType) -> (Result_4);
  unlock_funds : (text, text, nat64, opt text) -> (Result);
  validate_rune : (text) -> (Result) query;
  withdraw_bitcoin_fees : (text, nat64) -> (Result_4);
}
