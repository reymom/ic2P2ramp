type Ed25519KeyName = variant {
  MainnetTestKey1;
  LocalDevelopment;
  MainnetProdKey1;
};
type InitArg = record {
  ed25519_key_name : Ed25519KeyName;
  network : SolanaCluster;
  sol_rpc_canister_id : opt principal;
  proxy_url : text;
};
type InstallArg = variant { Upgrade : opt UpdateArg; Reinstall : InitArg };
type Result = variant { Ok : text; Err : SolanaError };
type Result_1 = variant { Ok; Err : SolanaError };
type Result_2 = variant { Ok : nat; Err : SolanaError };
type Result_3 = variant { Ok : VaultEntry; Err : SolanaError };
type Result_4 = variant { Ok : TokenAmount; Err : SolanaError };
type SolanaCluster = variant { Mainnet; Testnet; Devnet };
type SolanaError = variant {
  RpcError : text;
  AccountNotFound;
  BlockhashErrors : text;
  ParsePubkeyError : text;
  SystemError : SystemError;
  VaultError : VaultError;
  UnsupportedToken : text;
};
type SystemError = variant {
  HttpRequestError : record { nat64; text };
  ParseError : text;
  Utf8Error;
};
type TokenAmount = record {
  decimals : nat8;
  uiAmount : opt float64;
  uiAmountString : text;
  amount : text;
};
type UpdateArg = record {
  network : opt SolanaCluster;
  sol_rpc_canister_id : opt principal;
  proxy_url : opt text;
};
type VaultEntry = record {
  lamports : nat64;
  tokens : vec record { text; nat64 };
};
type VaultError = variant { InsufficientBalance; AddressVaultNotFound };
service : (InstallArg) -> {
  associated_token_account : (text, text) -> (Result);
  cancel_deposit : (text, nat64, opt text) -> (Result_1);
  canister_solana_account : () -> (text);
  complete_order : (text, nat64, opt text) -> (Result_1);
  create_associated_token_account : (opt principal, text) -> (Result);
  deposit_to_vault_canister : (text, nat64, opt text) -> (Result_1);
  get_balance : (text) -> (Result_2);
  get_offramper_deposits : (text) -> (Result_3) query;
  get_onramper_deposits : (text) -> (Result_3) query;
  get_registered_tokens : () -> (vec record { text; nat8 }) query;
  get_spl_token_balance : (text, text) -> (Result_4);
  is_token_supported : (text) -> (Result_1) query;
  lock_funds : (text, text, nat64, opt text) -> (Result_1);
  owned_associated_token_account : (opt principal, text) -> (Result);
  owned_get_spl_token_balance : (opt text, text) -> (Result_4);
  owned_solana_account : (opt principal) -> (text);
  register_tokens : (vec text) -> (Result_1);
  send_sol : (opt principal, text, nat) -> (Result);
  send_spl_token : (opt principal, text, text, nat) -> (Result);
  unlock_funds : (text, text, nat64, opt text) -> (Result_1);
  withdraw_solana_fees : (text, nat64) -> (Result);
}
